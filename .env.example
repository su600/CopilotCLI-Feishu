# Feishu app config
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=

# Optional: use an OpenAI-compatible chat API for smart replies
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: customize the fallback bot name shown in help text
BOT_NAME=Feishu Local Bot

# Optional: working directory used when executing PowerShell/copilot commands
# Defaults to the current user's home directory
WORK_DIR=

# Optional: directory where generated screenshots are stored
# Defaults to ~/.feishu-bot/artifacts
ARTIFACT_DIR=
